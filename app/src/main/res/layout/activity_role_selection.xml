<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/white_100">

    <!-- Icon -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_user"
        android:layout_marginBottom="32dp"
        app:tint="@color/orange_100" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn vai trò của bạn"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/orange_100"
        android:layout_marginBottom="16dp" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vai trò này sẽ giúp chúng tôi tùy chỉnh trải nghiệm phù hợp với bạn"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:layout_marginBottom="48dp" />

    <!-- Role Selection -->
    <RadioGroup
        android:id="@+id/roleRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Landlord Card -->
        <LinearLayout
            android:id="@+id/landlordCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/role_card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <RadioButton
                android:id="@+id/landlordRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clickable="false"
                android:focusable="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chủ trọ"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/orange_100" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng tin cho thuê phòng trọ"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_landlord"
                android:layout_gravity="center_vertical"
                app:tint="@color/orange_100" />

        </LinearLayout>

        <!-- Tenant Card -->
        <LinearLayout
            android:id="@+id/tenantCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/role_card_background"
            android:padding="16dp"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <RadioButton
                android:id="@+id/tenantRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clickable="false"
                android:focusable="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Người thuê"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/orange_100" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tìm kiếm phòng trọ phù hợp"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_tenant"
                android:layout_gravity="center_vertical"
                app:tint="@color/orange_100" />

        </LinearLayout>

    </RadioGroup>

    <!-- Confirm Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirmButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Xác nhận"
        android:textSize="16sp"
        android:layout_marginTop="48dp"
        style="@style/Widget.Material3.Button" />

</LinearLayout>