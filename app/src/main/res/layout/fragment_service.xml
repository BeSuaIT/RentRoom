<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkerwhite"
    tools:context=".Fragments.ServiceFragment">

    <RelativeLayout
        android:id="@+id/constraintLayout3"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/orange"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/service_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Dịch vụ"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/button_cart"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_cart" />
    </RelativeLayout>

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout3">

        <androidx.cardview.widget.CardView
            style="@style/ServiceCardView">

            <LinearLayout
                android:id="@+id/chothuenoithat"
                style="@style/ServiceItemLayout">

                <ImageView
                    style="@style/ServiceItemImage"
                    android:src="@drawable/ic_chothuenoithat" />

                <TextView
                    style="@style/ServiceItemText"
                    android:text="Cho thuê nội thất" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/ServiceCardView">

            <LinearLayout
                android:id="@+id/tuvanthietkephong"
                style="@style/ServiceItemLayout">

                <ImageView
                    style="@style/ServiceItemImage"
                    android:src="@drawable/ic_tuvanthietkephong" />

                <TextView
                    style="@style/ServiceItemText"
                    android:text="Tư vấn thiết kế phòng" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/ServiceCardView">

            <LinearLayout
                android:id="@+id/suachuadiennuoc"
                style="@style/ServiceItemLayout">

                <ImageView
                    style="@style/ServiceItemImage"
                    android:src="@drawable/ic_suachuadiennuoc" />

                <TextView
                    style="@style/ServiceItemText"
                    android:text="Sửa chữa điện nước" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/ServiceCardView">

            <LinearLayout
                android:id="@+id/giatla"
                style="@style/ServiceItemLayout">

                <ImageView
                    style="@style/ServiceItemImage"
                    android:src="@drawable/ic_giatla" />

                <TextView
                    style="@style/ServiceItemText"
                    android:text="Giặt là" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/ServiceCardView">

            <LinearLayout
                android:id="@+id/doibinhnuoc"
                style="@style/ServiceItemLayout">

                <ImageView
                    style="@style/ServiceItemImage"
                    android:src="@drawable/ic_doibinhnuoc" />

                <TextView
                    style="@style/ServiceItemText"
                    android:text="Đổi bình nước" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            style="@style/ServiceCardView">

            <LinearLayout
                android:id="@+id/doibinhga"
                style="@style/ServiceItemLayout">

                <ImageView
                    style="@style/ServiceItemImage"
                    android:src="@drawable/ic_doibinhga" />

                <TextView
                    style="@style/ServiceItemText"
                    android:text="Đổi bình ga" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>