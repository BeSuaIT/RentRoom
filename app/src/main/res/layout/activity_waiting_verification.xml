<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/white_100">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_email"
        android:layout_marginBottom="32dp"
        app:tint="@color/orange_100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Xác minh email"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/orange_100"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="@color/orange_100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đang chờ xác minh..."
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/resendButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Gửi lại email"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/changeEmailButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Thay đổi email"
        android:textSize="16sp"
        android:backgroundTint="@color/orange_100"
        style="@style/Widget.Material3.Button" />

</LinearLayout>