<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView 
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white_90"
        android:fillViewport="true"
        tools:context=".Fragments.HomeFragment">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/imageSlider_cardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="4dp">

                <com.denzcoskun.imageslider.ImageSlider
                    android:id="@+id/imageSlider"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:iss_auto_cycle="true"
                    app:iss_delay="1000"
                    app:iss_period="1000"
                    app:iss_title_background="@drawable/default_gradient"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/shortcut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-25dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/search_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/gray"/>

                        <TextView
                            android:id="@+id/searchEditText"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="12dp"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:hint="@string/Search"
                            android:textSize="16sp"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            app:cardBackgroundColor="@color/orange_60"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                            <Spinner
                                android:id="@+id/city_spinner"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:dropDownVerticalOffset="8dp"
                                android:overlapAnchor="false"
                                android:popupBackground="@drawable/spinner_dropdown_background"
                                android:spinnerMode="dropdown"/>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/tin_dang_cho_thue"
                                style="@style/ShortcutButtonStyle"
                                android:visibility="gone">

                                <ImageView
                                    style="@style/ShortcutIconStyle"
                                    android:src="@drawable/img_post_room" />

                                <TextView
                                    style="@style/ShortcutTextStyle"
                                    android:text="Đăng tin cho thuê" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/cart"
                                style="@style/ShortcutButtonStyle">

                                <ImageView
                                    style="@style/ShortcutIconStyle"
                                    android:src="@drawable/img_cart" />

                                <TextView
                                    style="@style/ShortcutTextStyle"
                                    android:text="Giỏ hàng" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/doi_binh_ga"
                                style="@style/ShortcutButtonStyle">

                                <ImageView
                                    style="@style/ShortcutIconStyle"
                                    android:src="@drawable/img_gas" />

                                <TextView
                                    style="@style/ShortcutTextStyle"
                                    android:text="Đổi bình ga" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/doi_binh_nuoc"
                                style="@style/ShortcutButtonStyle">

                                <ImageView
                                    style="@style/ShortcutIconStyle"
                                    android:src="@drawable/img_binhnuoc" />

                                <TextView
                                    style="@style/ShortcutTextStyle"
                                    android:text="Đổi bình nước" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/giat_la"
                                style="@style/ShortcutButtonStyle">

                                <ImageView
                                    style="@style/ShortcutIconStyle"
                                    android:src="@drawable/img_washingmachine" />

                                <TextView
                                    style="@style/ShortcutTextStyle"
                                    android:text="Giặt là" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/sua_chua_dien_nuoc"
                                style="@style/ShortcutButtonStyle">

                                <ImageView
                                    style="@style/ShortcutIconStyle"
                                    android:src="@drawable/img_toolbox" />

                                <TextView
                                    style="@style/ShortcutTextStyle"
                                    android:text="Sửa chữa điện nước" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/tu_van_thiet_ke_phong"
                                style="@style/ShortcutButtonStyle">

                                <ImageView
                                    style="@style/ShortcutIconStyle"
                                    android:src="@drawable/img_tuvan" />

                                <TextView
                                    style="@style/ShortcutTextStyle"
                                    android:text="Tư vấn thiết kế phòng" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/cho_thue_noi_that"
                                style="@style/ShortcutButtonStyle">

                                <ImageView
                                    style="@style/ShortcutIconStyle"
                                    android:src="@drawable/img_furniture" />

                                <TextView
                                    style="@style/ShortcutTextStyle"
                                    android:text="Mua nội thất" />
                            </LinearLayout>

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/Explore"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/district_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">

                    <include layout="@layout/view_holder_district_shimmer"/>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcv_district"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/Recent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Danh sách bài đăng"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/showMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Showmore"
                    android:textColor="@color/red"
                    android:textSize="16sp"/>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/room_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    
                    <include layout="@layout/view_holder_room_shimmer"/>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcv_room"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="100dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
